# Base URL for the backend API (no trailing slash)
# Monolith:      http://localhost:4000
# Three-tier:    http://localhost:4001
# Microservices: http://localhost:8000
VITE_API_BASE_URL=http://localhost:4000

# Architecture mode -- purely informational, shown on /arch-demo
# Values: monolith | three-tier | microservices
VITE_ARCH_MODE=monolith
